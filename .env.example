# Copy to .env and fill in. Never commit .env.

# Claude API key from https://platform.claude.com — keeps JARVIS out of demo mode.
# Stored only on the server; the browser never sees it.
ANTHROPIC_API_KEY=

# Server
PORT=8787
HOST=0.0.0.0
# DATA_DIR=./data            # SQLite database location (default: ./data)

# Sign-ups: unset = only the first account may register; 1 = open; 0 = closed.
# ALLOW_SIGNUP=

# Set to 1 when serving over HTTPS so session cookies are marked Secure.
# COOKIE_SECURE=1
# Express "trust proxy" setting when behind a reverse proxy (e.g. 1, loopback, uniquelocal).
# TRUST_PROXY=loopback

# Web Push (optional). If unset, keys are generated and stored in the database.
# Generate with: npm run vapid -w server
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Force demo mode even with a key (for testing): JARVIS_DEMO=1
