{
  "name": "jarvis-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env --no-warnings=ExperimentalWarning src/index.ts",
    "start": "tsx --env-file-if-exists=../.env --no-warnings=ExperimentalWarning src/index.ts",
    "test": "NODE_OPTIONS=--no-warnings=ExperimentalWarning vitest run",
    "typecheck": "tsc --noEmit",
    "vapid": "tsx src/scripts/vapid.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
